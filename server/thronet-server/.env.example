# ============================================================================
# .env.example
# Complete environment configuration template for Throne8 Backend Server
# Includes dual Redis architecture, domain kill switches, and TTL configurations.
# ============================================================================

NODE_ENV=production
PORT=5000
APP_VERSION=1.0.0

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/thronet?retryWrites=true&w=majority

# ----------------------------------------------------------------------------
# 1. Primary Redis Instance: Cache & Ephemeral State (allkeys-lru)
# ----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0
REDIS_CLUSTER_MODE=false
REDIS_COMMAND_TIMEOUT_MS=2000

# ----------------------------------------------------------------------------
# 2. Secondary Dedicated Redis Instance: BullMQ Queues (noeviction + AOF)
# ----------------------------------------------------------------------------
# Dedicated instance for background jobs to prevent eviction of job queues
REDIS_QUEUE_URL=redis://127.0.0.1:6379

# ----------------------------------------------------------------------------
# Socket.IO & Multi-Instance Cluster
# ----------------------------------------------------------------------------
# Enables Redis Pub/Sub adapter for cross-instance messaging and presence
SOCKET_REDIS_ADAPTER_ENABLED=true

# ----------------------------------------------------------------------------
# Token Blacklist & Legacy Key Migration
# ----------------------------------------------------------------------------
# Intercepts legacy raw keys (e.g. bl:<token>) during zero-downtime migration
BLACKLIST_LEGACY_RAW_KEYS_ENABLED=true

# ----------------------------------------------------------------------------
# Global & Domain Cache Kill Switches (Set 'false' to bypass to MongoDB)
# ----------------------------------------------------------------------------
CACHE_GLOBAL_ENABLED=true
CACHE_AUTH_ENABLED=true
CACHE_PROFILE_ENABLED=true
CACHE_NOTIFICATION_ENABLED=true
CACHE_CHAT_ENABLED=true
CACHE_CONNECTIONS_ENABLED=true
CACHE_LEADERBOARD_ENABLED=true
CACHE_ANALYTICS_ENABLED=true
CACHE_DOUBT_ENABLED=true
CACHE_COMPANY_ENABLED=true
CACHE_COMMENT_ENABLED=true
CACHE_REACTION_ENABLED=true
CACHE_MASTER_ENABLED=true
CACHE_SOCKET_ENABLED=true
CACHE_QUEUE_EMAIL_ENABLED=true
CACHE_QUEUE_NOTIFICATION_ENABLED=true

# ----------------------------------------------------------------------------
# Cache TTLs (Seconds) - Automated ±10% Jitter Applied by CacheHelper
# ----------------------------------------------------------------------------
AUTH_USER_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=3600
PROFILE_CACHE_TTL_SECONDS=1800
NOTIFICATION_UNREAD_COUNT_TTL_SECONDS=300
CHAT_CONVERSATION_LIST_TTL_SECONDS=180
CHAT_UNREAD_COUNT_TTL_SECONDS=120
CONNECTIONS_COUNT_TTL_SECONDS=600
CONNECTIONS_GRAPH_TTL_SECONDS=1800
CONNECTIONS_BLOCKS_TTL_SECONDS=3600
LEADERBOARD_SET_TTL_SECONDS=3600
STUDY_ANALYTICS_TTL_SECONDS=900
DOUBTS_FEED_TTL_SECONDS=180
COMPANY_PROFILE_TTL_SECONDS=1800
POST_COMMENTS_TTL_SECONDS=60
POST_REACTIONS_TTL_SECONDS=120
MASTER_DATA_TTL_SECONDS=86400
PRESENCE_SOCKET_TTL_SECONDS=120
LIVEROOM_SESSION_TTL_SECONDS=86400

# ----------------------------------------------------------------------------
# JWT & Authentication Secrets
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# Observability & Prometheus Metrics
# ----------------------------------------------------------------------------
METRICS_PROMETHEUS_ENABLED=true
METRICS_PROMETHEUS_PATH=/metrics
