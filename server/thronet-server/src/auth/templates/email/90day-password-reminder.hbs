{{!-- // src/templates/email/90day-password-reminder.hbs --}}
<html>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Password Re-Verification Required</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f4f4f4;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      }
      .header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        padding: 30px;
        text-align: center;
        color: white;
      }
      .content {
        padding: 40px;
      }
      .info {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 15px;
        color: #856404;
        border-radius: 4px;
        margin: 20px 0;
      }
      .tip {
        background: #d4edda;
        border-left: 4px solid #28a745;
        padding: 15px;
        color: #155724;
        border-radius: 4px;
        margin: 20px 0;
      }
      .footer {
        padding: 20px;
        text-align: center;
        color: #999;
        font-size: 12px;
        border-top: 1px solid #eee;
        margin-top: 40px;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>Password Re-Verification Required</h1>
      </div>
      <div class='content'>
        <p style='font-size: 16px; color: #333;'>Hello {{userName}},</p>
        <p style='font-size: 16px; color: #333;'>
          It's been
          <strong>{{daysSinceChange}} days</strong>
          since your last password verification.
        </p>

        <div class='info'>
          <p style='margin: 0;'>
            For security compliance, you will be asked to re-enter your current
            password on your next login.
          </p>
        </div>

        <div class='tip'>
          <p style='margin: 0;'>
            Tip: Consider updating your password regularly for better security.
          </p>
        </div>

        <p style='color: #666; font-size: 14px;'>
          This is a routine security measure to protect your account.
        </p>
      </div>
      <div class='footer'>
        <p>© 2025 Auth Service. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>