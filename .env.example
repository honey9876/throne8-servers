# =
# 
# .env.production
# Ye file: project root mein rakho
# KABHI git push mat karna — .gitignore mein already add hai
# =

NODE_ENV=
PORT=
API_VERSION=
API_PREFIX=

# Apna production domain dalo (localhost nahi)
ALLOWED_ORIGINS=
ALLOWED_METHODS=
FRONTEND_URL=

# ── JWT & Secrets ─────────────────────────────────────────
# Naye generate karo: terminal mein chalao =
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
JWT_ACCESS_SECRET=
JWT_SESSION_SECRET=
SESSION_SECRET=
REFRESH_TOKEN_SALT=
MFA_TOKEN_SALT=
OAUTH_CLIENT_SALT=
OTP_SALT=

ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=
REFRESH_TOKEN_REMEMBER_EXPIRY=


# throne8pvtltd_db_user 
# Thronet2026Prodapp

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=
LOG_FILE_ENABLED=
LOG_DIR=

# ── MongoDB ───────────────────────────────────────────────
# Docker compose wala replica set use karega
MONGODB_URI=

# Ye docker-compose.prod.yml mein bhi use hote hain
MONGO_APP_PASSWORD=
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_DB_NAME=

# ── Redis ─────────────────────────────────────────────────
REDIS_CLUSTER_MODE=
REDIS_CLUSTER_NODES=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_KEY_PREFIX=
REDIS_CONNECTION_TIMEOUT=
REDIS_COMMAND_TIMEOUT=
REDIS_MAX_RETRIES=
REDIS_RETRY_DELAY=
REDIS_MAX_CONNECTIONS=
REDIS_MIN_CONNECTIONS=
REDIS_ENABLE_COMPRESSION=
REDIS_HOST_1=
REDIS_PORT_1=
REDIS_HOST_2=
REDIS_PORT_2=
REDIS_HOST_3=
REDIS_PORT_3=

# ── Cache ─────────────────────────────────────────────────
CACHE_USER_TTL=
CACHE_SESSION_TTL=
CACHE_QUERY_TTL=
CACHE_RATE_LIMIT_TTL=
CACHE_MFA_TTL=
CACHE_USER_PREFIX=
CACHE_SESSION_PREFIX=
CACHE_QUERY_PREFIX=
CACHE_RATE_LIMIT_PREFIX=
CACHE_MFA_PREFIX=

# ── Socket ────────────────────────────────────────────────
SOCKET_PING_TIMEOUT=
SOCKET_PING_INTERVAL=

# ── Email ─────────────────────────────────────────────────
# Gmail app password: myaccount.google.com → Security → App passwords
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_SECURE=

# ── Twilio ────────────────────────────────────────────────
# console.twilio.com se naya token lo — purana rotate karo
SMS_API_KEY=
SMS_FROM_NUMBER=
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Google OAuth ──────────────────────────────────────────
# console.cloud.google.com → regenerate karo
# Callback URL production wala hona chahiye
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── GitHub OAuth ──────────────────────────────────────────
# github.com/settings/developers → regenerate karo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ── Cloudinary ────────────────────────────────────────────
# cloudinary.com/console → API secret regenerate karo
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=
CLOUDINARY_MAX_FILE_SIZE=
CLOUDINARY_SECURE_URLS=
CLOUDINARY_AUTO_QUALITY=
CLOUDINARY_AUTO_FORMAT=

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_LOGIN=
RATE_LIMIT_REGISTER=
RATE_LIMIT_PASSWORD_RESET=
RATE_LIMIT_API=

# ── Request Config ────────────────────────────────────────
REQUEST_TIMEOUT=
BODY_SIZE_LIMIT=
KEEP_ALIVE_TIMEOUT=

# ── Session Cookie ────────────────────────────────────────
SESSION_SECURE=
SESSION_HTTP_ONLY=
SESSION_SAME_SITE=

# ── Password Policy ───────────────────────────────────────
PASSWORD_MIN_LENGTH=
PASSWORD_REQUIRE_UPPERCASE=
PASSWORD_REQUIRE_LOWERCASE=
PASSWORD_REQUIRE_NUMBERS=
PASSWORD_REQUIRE_SYMBOLS=

# ── Features ──────────────────────────────────────────────
ENABLE_MFA=
ENABLE_OAUTH=
ENABLE_EMAIL_VERIFICATION=
ENABLE_SMS_VERIFICATION=
ENABLE_AUDIT_LOGS=
ENABLE_ANALYTICS=
HEALTH_CHECK_INTERVAL=

# ── Neo4j (disable hai abhi — jab use karo tab uncomment) ──
# NEO4J_URI=
# NEO4J_USERNAME=
# NEO4J_PASSWORD=
# NEO4J_ENCRYPTED=
# NEO4J_MAX_CONNECTION_POOL_SIZE=
# NEO4J_CONNECT_TIMEOUT=
# NEO4J_CONNECTION_ACQUISITION_TIMEOUT=
# NEO4J_MAX_RETRIES=
# NEO4J_RETRY_DELAY_MS=
# NEO4J_LOGGING_LEVEL=
# NEO4J_DATABASE=
# NEO4J_HEALTH_CHECK_INTERVAL_MS=
# NEO4J_MAX_CONNECTION_LIFETIME=
# NEO4J_MAX_TRANSACTION_RETRY_TIME=
# NEO4J_TRUST_STRATEGY=

# ── Docker image (docker-compose.prod.yml use karta hai) ──
DOCKER_IMAGE=
IMAGE_TAG=
